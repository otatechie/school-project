# Environment variables for a Dokploy deployment.
#
# Copy these into the service's Environment tab in Dokploy. Do not commit a
# filled-in copy of this file — the values below are placeholders only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="GovPay Desk"
APP_URL=https://govpay.example.com

# Generate locally with:  php artisan key:generate --show
# The container refuses to start without this. Keep it stable across deploys —
# changing it invalidates every existing session.
APP_KEY=

LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_DATABASE=govpay
DB_USERNAME=govpay
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Emerging technology — Claude API
# ---------------------------------------------------------------------------
# Obtain from https://console.anthropic.com. When this is blank the AI review
# and memo drafting features report themselves as unavailable and every manual
# workflow continues to function.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# First boot
# ---------------------------------------------------------------------------
# Seeds departments, the chart of accounts and demo accounts, but only while
# the database has no users. Set to false once the office has real data.
SEED_ON_FIRST_BOOT=true

# ---------------------------------------------------------------------------
# Demonstration mode
# ---------------------------------------------------------------------------
# Prefills the sign-in form with the superadmin and lists the sample accounts,
# so an assessor can reach the system without being handed credentials.
#
# MUST be false on any deployment holding real records — it publishes working
# credentials on a public page.
DEMO_MODE=true
DEMO_PASSWORD=password
